# Render PostgreSQL connection string (set DATABASE_URL in Render)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Use a long random value (at least 32 characters)
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ADMIN_USERNAME=admin
# Do not use 123 in production. Choose a strong password (12+ chars).
ADMIN_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD
ADMIN_DISPLAY_NAME=TEAM DUONG ADMIN
PORT=10000
